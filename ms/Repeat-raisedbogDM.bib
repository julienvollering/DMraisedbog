@online{meyerCASTPackageTraining2024,
  title = {The {{CAST}} Package for Training and Assessment of Spatial Prediction Models in {{R}}},
  author = {Meyer, Hanna and Ludwig, Marvin and Milà, Carles and Linnenbrink, Jan and Schumacher, Fabian},
  date = {2024-04-10},
