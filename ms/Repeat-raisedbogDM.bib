  author = {Zhang, Hui and Väliranta, Minna and Swindles, Graeme T. and Aquino-López, Marco A. and Mullan, Donal and Tan, Ning and Amesbury, Matthew and Babeshko, Kirill V. and Bao, Kunshan and Bobrov, Anatoly and Chernyshov, Viktor and Davies, Marissa A. and Diaconu, Andrei-Cosmin and Feurdean, Angelica and Finkelstein, Sarah A. and Garneau, Michelle and Guo, Zhengtang and Jones, Miriam C. and Kay, Martin and Klein, Eric S. and Lamentowicz, Mariusz and Magnan, Gabriel and Marcisz, Katarzyna and Mazei, Natalia and Mazei, Yuri and Payne, Richard and Pelletier, Nicolas and Piilo, Sanna R. and Pratte, Steve and Roland, Thomas and Saldaev, Damir and Shotyk, William and Sim, Thomas G. and Sloan, Thomas J. and Słowiński, Michał and Talbot, Julie and Taylor, Liam and Tsyganov, Andrey N. and Wetterich, Sebastian and Xing, Wei and Zhao, Yan},
