}

@article{egorovDinamikaOblesennostiVerhovyh2024,
  title = {Dynamics of the forest cover of raised bogs in southern taiga: Zapadnaya Dvina forest peatland station as an example (Tver region)},
  author = {Egorov, Kirill P. and Medvedeva, Maria A. and Galanina, Olga V.},
