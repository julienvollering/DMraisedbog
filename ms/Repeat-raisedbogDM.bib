@article{fosterRISDMSpeciesDistribution2024,
  title = {‘{{RISDM}}‘: Species Distribution Modelling from Multiple Data Sources in {{R}}},
  shorttitle = {‘{{RISDM}}‘},
  author = {Foster, Scott D. and Peel, David and Hosack, Geoffrey R. and Hoskins, Andrew and Mitchell, David J. and Proft, Kirstin and Yang, Wen-Hsi and Uribe-Rivera, David E and Froese, Jens G.},
  date = {2024},
  journaltitle = {Ecography},
  volume = {2024},
