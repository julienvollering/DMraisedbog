@article{kargerClimatologiesHighResolution2017,
  title = {Climatologies at High Resolution for the Earth's Land Surface Areas},
  author = {Karger, D N and Conrad, O and Böhner, J and Kawohl, T and Kreft, H and Soria-Auza, R W and Zimmermann, N E and Linder, H P and Kessler, M},
  date = {2017},
  journaltitle = {Scientific Data},
